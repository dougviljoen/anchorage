# The app remains functional with demo data while this is true.
VITE_DEMO_MODE=true
VITE_APP_ENV=development

# Safe to expose in the browser. Obtain these from the Supabase and Google Cloud
# project consoles. Restrict the Google browser key to approved website
# referrers and the Maps JavaScript API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback. Leave blank when using a current sb_publishable_ key.
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
VITE_GOOGLE_MAP_ID=
# Embedded keeps Anchorage's calm map style in source control. Switch to cloud
# after associating an equivalent Google Cloud map style with the Map ID.
VITE_GOOGLE_MAP_STYLE_MODE=embedded

# Server-only secrets for Supabase Edge Functions. Never prefix these with VITE_.
SUPABASE_SECRET_KEY=

# Legacy fallback. Leave blank when using a current sb_secret_ key.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
OPENAI_COMPOSER_MODEL=gpt-5.6-terra

# Use a separate key from the browser key. Restrict it to Places API (New) and
# Routes API. Add an IP restriction once the production egress IP is stable.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional browser error reporting.
VITE_SENTRY_DSN=
